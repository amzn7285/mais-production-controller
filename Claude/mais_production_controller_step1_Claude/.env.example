# Copy to .env and adjust. All values shown are the defaults from
# ProductionControllerSettings; nothing here needs to be set unless
# you're overriding a default.

MAIS_PC_ENVIRONMENT=development
MAIS_PC_STATE_STORE_BACKEND=sqlite
MAIS_PC_EVENT_PUBLISHER_BACKEND=log
MAIS_PC_DEFAULT_MAX_RETRY_ATTEMPTS=3
MAIS_PC_DEFAULT_RETRY_BACKOFF_SECONDS=5.0
MAIS_PC_DEFAULT_RETRY_BACKOFF_MULTIPLIER=2.0
MAIS_PC_DEFAULT_AGENT_TIMEOUT_SECONDS=60.0
MAIS_PC_DEFAULT_PROVIDER_TIMEOUT_SECONDS=30.0
MAIS_PC_STAGE_CONFIG_PATH=config/stages.json
MAIS_PC_MAX_PARALLEL_AGENTS=4
